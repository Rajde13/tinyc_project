// FizzBuzz: prints 0 for plain numbers, -3 for Fizz, -5 for Buzz, -15 for FizzBuzz
// (the language only has integers, so the codes stand in for words)
let i = 1;
while (i <= 20) {
    if (i % 15 == 0) {
        print -15;
    } else if (i % 3 == 0) {
        print -3;
    } else if (i % 5 == 0) {
        print -5;
    } else {
        print i;
    }
    i = i + 1;
}
